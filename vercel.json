{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tonnel.io"
        }
      ],
      "destination": "https://airdrop.tonigma.network/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.tonnel.io"
        }
      ],
      "destination": "https://airdrop.tonigma.network/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "airdrop.tonnel.io"
        }
      ],
      "destination": "https://airdrop.tonigma.network/:path*",
      "permanent": true
    }
  ]
}
